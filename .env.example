# ===========================================
# PodTrans Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ===========================================
# API Keys
# ===========================================

# HuggingFace token for accessing pyannote.audio models
# Get it from: https://huggingface.co/settings/tokens
# IMPORTANT: Accept model licenses at:
# - https://huggingface.co/pyannote/segmentation-3.0
# - https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# ===========================================
# Translation API (OpenAI-compatible)
# ===========================================
# PodTrans uses OpenAI-compatible API. You can use:
# - DashScope (Qwen models) - Recommended for Chinese users
# - OpenAI official API
# - DeepSeek, Moonshot, or any OpenAI-compatible service

# API Key (despite the variable name, you can use any service's key)
DASHSCOPE_API_KEY=your_api_key_here

# API Base URL (OpenAI-compatible endpoint)
# For DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# For OpenAI: https://api.openai.com/v1
# For others: https://your-service-url/v1
TRANSLATION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model name
# For DashScope: qwen-coder-plus, qwen-plus, qwen-turbo, qwen-max
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# For others: check your service's model list
TRANSLATION_MODEL=qwen-coder-plus

# Maximum tokens per translation batch (default: 120000 for 128k context models)
# The translator will automatically batch segments to stay under this limit
# For 128k models: set to 120000 (leaves room for system prompt and response)
# For 32k models: set to 30000
TRANSLATION_MAX_TOKENS=120000

# ===========================================
# Voice Sample Extraction Configuration
# ===========================================

# Whether to extract voice cloning samples during pipeline processing
# Set to false to skip voice sample extraction
VOICE_SAMPLE_EXTRACT_ENABLED=true

# Voice sample duration constraints (in seconds)
VOICE_SAMPLE_MIN_DURATION=5.0
VOICE_SAMPLE_MAX_DURATION=20.0

# Minimum quality score for voice samples (0-100)
# Samples below this threshold will be discarded
VOICE_SAMPLE_MIN_QUALITY=60.0

# Maximum gap between merged segments (in seconds)
# Segments separated by less than this time will be merged
VOICE_SAMPLE_MAX_GAP=2.0

# ===========================================
# TTS Configuration
# ===========================================

# SoulX-Podcast API URL (your externally deployed service)
SOULX_API_URL=http://localhost:8000

# SoulX API request timeout in seconds (default: 300 = 5 minutes)
# Increase for very long podcasts
SOULX_TIMEOUT=300.0

# ===========================================
# ASR Configuration
# ===========================================

# Whisper model size (tiny, base, small, medium, large-v2, large-v3)
# Recommended: medium for Mac M4, large-v2 for CUDA GPU
WHISPER_MODEL=medium

# Device (cuda, cpu, mps)
# Note: mps not supported by faster-whisper, use cpu for Mac
DEVICE=cpu

# Compute type (int8, float16, float32)
# int8 for CPU, float16 for CUDA
COMPUTE_TYPE=int8

# ===========================================
# Processing Configuration
# ===========================================

# Batch size for ASR processing
ASR_BATCH_SIZE=16

# Maximum number of segments per translation batch (recommended: 50-100)
# Even if tokens allow more, keeping this lower improves API stability
TRANSLATION_MAX_SEGMENTS_PER_BATCH=100

# Maximum retries for API calls
MAX_RETRIES=3

# ===========================================
# Application Configuration
# ===========================================

# Output directory for processed files
OUTPUT_DIR=./data/output

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory
LOG_DIR=./logs
