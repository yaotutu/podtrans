# ===========================================
# PodTrans 配置模板
# ===========================================
# 复制此文件为 .env 并填入你的配置值
# 注意：不要将 .env 提交到版本控制

# ===========================================
# API 密钥配置
# ===========================================

# HuggingFace 访问令牌（用于下载 pyannote.audio 说话人分离模型）
# 获取地址: https://huggingface.co/settings/tokens
# 重要: 需要在以下页面接受模型使用协议:
# - https://huggingface.co/pyannote/segmentation-3.0
# - https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# LLM API 密钥（用于翻译，支持任意 OpenAI 兼容服务）
# DashScope 获取地址: https://dashscope.console.aliyun.com/
# OpenAI 获取地址: https://platform.openai.com/api-keys
LLM_API_KEY=your_api_key_here

# ===========================================
# LLM 配置（用于翻译）
# ===========================================

# LLM 模型名称
# DashScope 可用模型: qwen-max, qwen-plus, qwen-turbo, qwen-coder-plus
# OpenAI 可用模型: gpt-4o-mini, gpt-4o, gpt-4-turbo
LLM_MODEL=qwen-coder-plus

# LLM API 地址（OpenAI 兼容格式）
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI: https://api.openai.com/v1
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 每批翻译的最大 token 数（默认: 120000，适配 128k 上下文模型）
# 翻译器会自动将段落分批，确保不超过此限制
# 128k 模型建议: 120000（预留空间给系统提示词和响应）
# 32k 模型建议: 30000
LLM_MAX_TOKENS=120000

# 每批翻译的最大段落数（推荐: 50-100）
# 即使 token 数允许更多，保持较低值可提高 API 稳定性
LLM_MAX_SEGMENTS_PER_BATCH=100

# ===========================================
# 声音样本提取配置
# ===========================================

# 是否在处理流程中提取声音克隆样本
# 设为 false 可跳过声音样本提取步骤
VOICE_SAMPLE_EXTRACT_ENABLED=true

# 声音样本时长限制（秒）
# 最小时长: 太短的样本声音特征不够明显
VOICE_SAMPLE_MIN_DURATION=5.0
# 最大时长: 太长会增加处理时间且不必要
VOICE_SAMPLE_MAX_DURATION=20.0

# 声音样本最低质量分数（0-100）
# 低于此阈值的样本将被丢弃
VOICE_SAMPLE_MIN_QUALITY=60.0

# 合并片段时的最大间隔（秒）
# 间隔小于此值的相邻片段会被合并
VOICE_SAMPLE_MAX_GAP=2.0

# ===========================================
# TTS 语音合成配置
# ===========================================

# podcast-tts CLI 可执行文件路径
# 设置为你的 podcast-tts 完整路径
TTS_CLI_PATH=/path/to/podcast-tts

# TTS 处理超时时间（秒，默认: 3600 = 1小时）
# 长播客的 TTS 任务通常需要 30-60 分钟
TTS_TIMEOUT=3600

# ===========================================
# ASR 语音识别配置
# ===========================================

# Whisper 模型大小
# 可选: tiny, base, small, medium, large-v2, large-v3
# 推荐: Mac M系列用 medium，CUDA GPU 用 large-v2
WHISPER_MODEL=medium

# 计算设备
# cuda: NVIDIA GPU（推荐，速度最快）
# cpu: CPU（兼容性最好，速度较慢）
# 注意: mps 不被 faster-whisper 支持，Mac 请用 cpu
DEVICE=cpu

# 计算精度
# int8: CPU 推荐
# float16: CUDA GPU 推荐
# float32: 最高精度，速度最慢
COMPUTE_TYPE=int8

# ASR 批处理大小（默认: 16）
# 增大可提高 GPU 利用率，但需要更多显存
ASR_BATCH_SIZE=16

# ===========================================
# 通用处理配置
# ===========================================

# API 调用最大重试次数
MAX_RETRIES=3

# ===========================================
# 应用目录配置
# ===========================================

# 处理结果输出目录
OUTPUT_DIR=./output

# 模型和翻译缓存目录
CACHE_DIR=./cache

# 数据库文件目录（用于追踪剧集处理状态）
DATABASE_DIR=./database

# 日志级别
# 可选: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志文件目录
LOG_DIR=./logs
