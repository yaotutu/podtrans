# ===========================================
# PodTrans Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ===========================================
# API Keys
# ===========================================

# HuggingFace token for accessing pyannote.audio models
# Get it from: https://huggingface.co/settings/tokens
# Accept model licenses:
# - https://huggingface.co/pyannote/segmentation-3.0
# - https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# DashScope API key for translation (Alibaba Cloud)
# Get it from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ===========================================
# Translation Configuration
# ===========================================

# Translation model (default: qwen-coder-plus)
# Available models: qwen-coder-plus, qwen-plus, qwen-turbo, etc.
TRANSLATION_MODEL=qwen-coder-plus

# Translation API base URL (OpenAI-compatible endpoint)
TRANSLATION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Maximum tokens per translation batch (default: 120000 for 128k context models)
# The translator will automatically batch segments to stay under this limit
# For 128k models: set to 120000 (leaves room for system prompt and response)
# For 32k models: set to 30000
TRANSLATION_MAX_TOKENS=120000

# ===========================================
# TTS Configuration
# ===========================================

# SoulX-Podcast API URL (your externally deployed service)
SOULX_API_URL=http://localhost:8000

# SoulX API request timeout in seconds (default: 300 = 5 minutes)
# Increase for very long podcasts
SOULX_TIMEOUT=300.0

# ===========================================
# ASR Configuration
# ===========================================

# Whisper model size (tiny, base, small, medium, large-v2, large-v3)
# Recommended: medium for Mac M4, large-v2 for CUDA GPU
WHISPER_MODEL=medium

# Device (cuda, cpu, mps)
# Note: mps not supported by faster-whisper, use cpu for Mac
DEVICE=cpu

# Compute type (int8, float16, float32)
# int8 for CPU, float16 for CUDA
COMPUTE_TYPE=int8

# ===========================================
# Processing Configuration
# ===========================================

# Batch size for ASR processing
ASR_BATCH_SIZE=16

# Maximum number of segments per translation batch (recommended: 50-100)
# Even if tokens allow more, keeping this lower improves API stability
TRANSLATION_MAX_SEGMENTS_PER_BATCH=100

# Maximum retries for API calls
MAX_RETRIES=3

# ===========================================
# Application Configuration
# ===========================================

# Output directory for processed files
OUTPUT_DIR=./data/output

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory
LOG_DIR=./logs
