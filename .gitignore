# ===================================
# Project Specific
# ===================================

# Logs
logs/
*.log

# Data directories
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/rss_cache/*
!data/rss_cache/.gitkeep
data/rss_downloads/*
!data/rss_downloads/.gitkeep

# Baseline versions (keep in git for reference)
!data/baseline/
!data/baseline/**/*.json
!data/baseline/**/*.txt
!data/baseline/README.md
# But ignore archives
data/baseline/archive/

# Model files (if downloaded locally)
models/
pretrained_models/

# Temporary files
tmp/
temp/
*.tmp

# Audio files (except test fixtures)
*.mp3
*.wav
*.flac
*.m4a
!tests/fixtures/audio/*.mp3
!tests/fixtures/audio/*.wav

# JSON outputs (except test fixtures)
data/output/**/*.json
!tests/fixtures/data/*.json

# API keys and secrets
.env
secrets.json
credentials.json

# Package manager lock files
uv.lock
condaenv.*.requirements.txt
data/*
